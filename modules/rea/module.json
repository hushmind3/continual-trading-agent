{
  "schema": 1,
  "id": "rea",
  "group": {
    "id": "rea",
    "title": "REA 역공학"
  },
  "backend": {
    "namespace": "platform_plugins.rea",
    "entry": "register"
  },
  "frontend": {
    "entry": "frontend/register.ts"
  },
  "legacy_shared_code": false,
  "order": 20,
  "runtime": {
    "language": "python",
    "protocol": "module-jsonl-v1",
    "package": "rea",
    "entry": "rea_menu_manager",
    "command": [
      ".venv/Scripts/python.exe",
      "-I",
      "-X",
      "utf8",
      "-B",
      "{module}/backend/worker.py"
    ],
    "state": "runtime/rea/program_analysis"
  },
  "dependencies": {
    "python": "requirements.txt",
    "node": "package.json"
  },
  "data": [
    "runtime/rea"
  ],
  "settings": "configs/rea.json"
}
