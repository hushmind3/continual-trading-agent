+function configFieldLabel(schemaKey: string): string {
+  const rawLabel = schemaKey.split(".").pop() ?? schemaKey;
+  const englishLabel = rawLabel.split("_").map((word) =>
+    word.replace(/\b\w/g, (c) => c.toUpperCase())
+  ).join(" ");
+  const auxiliaryLabel = schemaKey.startsWith("auxiliary.")
+    ? AUXILIARY_FIELD_LABELS_KO[rawLabel]
+    : undefined;
+  let koreanLabel = CONFIG_LABELS_KO[schemaKey] ?? auxiliaryLabel ?? rawLabel.split("_").map((word) =>
+    CONFIG_LABEL_WORDS_KO[word.toLowerCase()] ?? word
+  ).join(" ");
+  const wrappedEnglish = koreanLabel.match(/^([A-Za-z][A-Za-z0-9 _-]*)\s*\(([^()]*)\)$/);
+  if (wrappedEnglish && /[가-힣]/.test(wrappedEnglish[2])) {
+    const labelWords = englishLabel.toLowerCase().split(/[ _-]+/).filter(Boolean);
+    const translatedPrefixWords = wrappedEnglish[1].toLowerCase().split(/[ _-]+/).filter(Boolean);
+    let wordIndex = 0;
+    const repeatsEnglishTitle = labelWords.every((word) => {
+      const matchIndex = translatedPrefixWords.indexOf(word, wordIndex);
+      if (matchIndex < 0) return false;
+      wordIndex = matchIndex + 1;
+      return true;
+    });
+    if (repeatsEnglishTitle) koreanLabel = wrappedEnglish[2];
+  }
+  return `${englishLabel} (${koreanLabel})`;
+}
