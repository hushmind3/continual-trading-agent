+function localizedSkillDescription(
+  skill: SkillInfo,
+  locale: string,
+  translations: Record<string, { hash: string; text: string }> | null,
+): string {
+  const source = skill.description || "";
+  const translated = translations?.[skill.name];
+  if (locale === "ko" && translated?.hash === skillDescriptionHash(source)) {
+    return translated.text;
+  }
+  return source;
+}
+
+function skillDescriptionHash(value: string): string {
+  let hash = 14695981039346656037n;
+  for (let i = 0; i < value.length; i += 1) {
+    hash ^= BigInt(value.charCodeAt(i));
+    hash = BigInt.asUintN(64, hash * 1099511628211n);
+  }
+  return hash.toString(16).padStart(16, "0");
+}
