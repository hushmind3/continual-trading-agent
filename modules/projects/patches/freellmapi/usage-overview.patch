diff --git a/client/src/components/usage-overview.tsx b/client/src/components/usage-overview.tsx
new file mode 100644
index 0000000..e6b3a51
--- /dev/null
+++ b/client/src/components/usage-overview.tsx
@@ -0,0 +1,28 @@
+import { useQuery } from '@tanstack/react-query'
+import { apiFetch } from '@/lib/api'
+import { useI18n } from '@/i18n'
+
+export function UsageOverview() {
+  const { locale } = useI18n()
+  const ko = locale === 'ko'
+  const { data: recent } = useQuery<{ rows: { platform: string; modelId: string }[] }>({
+    queryKey: ['current-routed-model'],
+    queryFn: () => apiFetch('/api/analytics/requests?range=24h&status=success&limit=1'),
+    refetchInterval: 5000,
+  })
+  const last = recent?.rows[0]
+  return (
+    <section className="mx-auto flex min-h-0 w-full max-w-lg flex-1 flex-col justify-center gap-5 p-5 sm:p-6" aria-label={ko ? '무료 모델 요약' : 'Free model summary'}>
+      <div className="rounded-2xl border bg-card p-7 text-center sm:p-8">
+        <h1 className="text-base font-medium text-muted-foreground">{ko ? '실제 남은 무료 잔액' : 'Actual free balance remaining'}</h1>
+        <p className="mt-3 text-2xl font-bold sm:text-3xl">{ko ? '조회할 수 없음' : 'Unavailable'}</p>
+        <p className="mt-2 text-sm text-muted-foreground">{ko ? 'FreeLLMAPI에서 업체 실제 잔액을 조회할 수 없습니다.' : 'FreeLLMAPI does not report actual provider balances here.'}</p>
+      </div>
+      <div className="rounded-2xl border bg-card px-5 py-4 text-center">
+        <p className="text-sm text-muted-foreground">{ko ? '최근 응답 모델' : 'Latest responding model'}</p>
+        <p className="mt-1 truncate text-base font-semibold">{last ? `${last.platform} · ${last.modelId}` : (ko ? '아직 완료된 응답이 없습니다' : 'No completed response yet')}</p>
+      </div>
+      <p className="text-center text-sm text-muted-foreground">{ko ? '카탈로그 한도나 사용 기록으로 잔액을 계산하지 않습니다.' : 'No balance is inferred from catalog limits or local usage.'}</p>
+    </section>
+  )
+}
