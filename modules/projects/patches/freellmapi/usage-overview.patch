@@ -0,0 +1,40 @@
+import { useQuery } from '@tanstack/react-query'
+import { apiFetch } from '@/lib/api'
+import { useI18n } from '@/i18n'
+import type { ModelGroupRow, TokenUsageData } from '@/lib/routing'
+
+export function UsageOverview({ groups, data, loading }: {
+  groups: ModelGroupRow[]
+  data?: TokenUsageData
+  loading: boolean
+}) {
+  const { locale } = useI18n()
+  const ko = locale === 'ko'
+  const { data: recent } = useQuery<{ rows: { platform: string; modelId: string }[] }>({
+    queryKey: ['current-routed-model'],
+    queryFn: () => apiFetch('/api/analytics/requests?range=24h&status=success&limit=1'),
+    refetchInterval: 5000,
+  })
+  const last = recent?.rows[0]
+  const lastName = last && groups.flatMap(g => g.members).find(m => m.platform === last.platform && m.modelId === last.modelId)?.displayName
+  const active = groups.flatMap(g => g.members.filter(m => m.enabled && (m.source ?? 'catalog') === 'catalog' && m.platform !== 'custom'))
+  const remaining = active.flatMap(m => {
+    const budget = data?.models.find(b => b.platform === m.platform && b.modelId === m.modelId)
+    return budget && budget.budget > 0 ? [Math.max(0, budget.budget - (budget.used ?? 0))] : []
+  })
+  const totalRemaining = remaining.reduce((sum, value) => sum + value, 0)
+  return (
+    <section className="mx-auto flex min-h-0 w-full max-w-lg flex-1 flex-col justify-center gap-5 p-5 sm:p-6" aria-label={ko ? '무료 모델 요약' : 'Free model summary'}>
+      <div className="rounded-2xl border bg-card p-7 text-center sm:p-8">
+        <h1 className="text-base font-medium text-muted-foreground">{ko ? '무료 한도 총량' : 'Free quota remaining'}</h1>
+        <p className="mt-3 text-4xl font-bold tabular-nums sm:text-5xl">{loading ? (ko ? '조회 중' : 'Loading') : remaining.length ? totalRemaining.toLocaleString(locale) : (ko ? '미확인' : 'Unknown')}</p>
+        <p className="mt-2 text-sm text-muted-foreground">{ko ? '토큰 · 등록된 무료 모델의 월 한도 추정 합계' : 'Tokens · estimated monthly total across listed free models'}</p>
+      </div>
+      <div className="rounded-2xl border bg-card px-5 py-4 text-center">
+        <p className="text-sm text-muted-foreground">{ko ? '최근 응답 모델' : 'Latest responding model'}</p>
+        <p className="mt-1 truncate text-base font-semibold">{last ? `${last.platform} · ${lastName ?? last.modelId}` : (ko ? '아직 완료된 응답이 없습니다' : 'No completed response yet')}</p>
+      </div>
+      <p className="text-center text-sm text-muted-foreground">{ko ? '업체 잔액이 아닌 FreeLLMAPI 카탈로그 기준 추정치입니다.' : 'Catalog estimate, not the providers’ actual balances.'}</p>
+    </section>
+  )
+}
