{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@platform/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src",
    "../modules/**/frontend/**/*.ts",
    "../modules/**/frontend/**/*.tsx"
  ]
}