+    def _windows_preset_argument(self) -> str:
+        """Keep native Windows argv ASCII; canonical presets remain unchanged."""
+        import configparser
+        import io
+        from utils import atomic_write_text
+        parser = configparser.ConfigParser(interpolation=None)
+        parser.optionxform = str
+        parser.read(self.preset_path, encoding="utf-8")
+        for section in parser.sections():
+            for key in ("model", "model-draft", "mmproj"):
+                if not parser.has_option(section, key):
+                    continue
+                value = parser.get(section, key)
+                if Path(value).is_absolute():
+                    try:
+                        parser.set(section, key, os.path.relpath(value, self.binary.parent))
+                    except ValueError:
+                        pass  # Another drive: retain the explicit user path.
+        target = self.preset_path.with_name("presets.windows.ini")
+        text = io.StringIO()
+        parser.write(text)
+        atomic_write_text(target, text.getvalue(), tmp_prefix=".windows-presets_", mode=0o600)
+        return os.path.relpath(target, self.binary.parent)
+
