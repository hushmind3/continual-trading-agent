@@ -0,0 +1,44 @@
+import { useQuery } from '@tanstack/react-query'
+import { apiFetch } from '@/lib/api'
+import { useI18n } from '@/i18n'
+import type { ModelGroupRow, TokenUsageData } from '@/lib/routing'
+
+export function UsageOverview({ groups, data, loading }: {
+  groups: ModelGroupRow[]
+  data?: TokenUsageData
+  loading: boolean
+}) {
+  const { locale } = useI18n()
+  const ko = locale === 'ko'
+  const { data: recent } = useQuery<{ rows: { platform: string; modelId: string }[] }>({
+    queryKey: ['current-routed-model'],
+    queryFn: () => apiFetch('/api/analytics/requests?range=24h&status=success&limit=1'),
+    refetchInterval: 5000,
+  })
+  const last = recent?.rows[0]
+  const lastName = last && groups.flatMap(g => g.members).find(m => m.platform === last.platform && m.modelId === last.modelId)?.displayName
+  const active = groups.flatMap(g => g.members.filter(m => m.enabled && (m.source ?? 'catalog') === 'catalog' && m.platform !== 'custom'))
+  return (
+    <section className="flex min-h-0 flex-1 flex-col gap-3 p-4" aria-label={ko ? '무료 모델 잔여량' : 'Free model balances'}>
+      <header className="flex shrink-0 items-center justify-between gap-2">
+        <h1 className="text-base font-semibold">{ko ? '무료 모델' : 'Free models'}</h1>
+        <span className="text-xs text-muted-foreground">{ko ? '남은 월 토큰 · 추정' : 'Monthly tokens left · Estimated'}</span>
+      </header>
+      <p className="shrink-0 truncate text-xs text-muted-foreground">{ko ? '최근 실제 응답' : 'Last served'} · {last ? `${last.platform} · ${lastName ?? last.modelId}` : (ko ? '최근 응답 없음' : 'No recent response')}</p>
+      <ul className="min-h-0 flex-1 divide-y overflow-y-auto rounded-2xl border bg-card" aria-label={ko ? '업체·모델별 남은 총량' : 'Balances by provider and model'}>
+        {active.map(m => {
+          const budget = data?.models.find(b => b.platform === m.platform && b.modelId === m.modelId)
+          const remaining = budget && budget.budget > 0 ? Math.max(0, budget.budget - (budget.used ?? 0)) : null
+          return (
+            <li key={m.modelDbId} className="flex items-center justify-between gap-3 px-3 py-3">
+              <div className="min-w-0"><p className="break-words text-sm font-medium">{m.displayName}</p><p className="mt-1 text-xs text-muted-foreground">{m.platform}</p></div>
+              <p className="shrink-0 text-sm font-semibold tabular-nums">{remaining === null ? (ko ? '미확인' : 'Unknown') : remaining.toLocaleString(locale)}</p>
+            </li>
+          )
+        })}
+        {(loading || !active.length) && <li className="p-3 text-sm text-muted-foreground">{loading ? (ko ? '조회 중' : 'Loading') : (ko ? '활성 모델 없음' : 'No active models')}</li>}
+      </ul>
+      <p className="shrink-0 text-xs text-muted-foreground">{ko ? '월 카탈로그 한도 기준 · 업체 실제 잔액 미연동' : 'Monthly catalog estimates · Actual balances not connected'}</p>
+    </section>
+  )
+}
