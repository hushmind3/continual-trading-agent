+++ b/client/src/components/usage-overview.tsx
@@ -0,0 +1,21 @@
+import { useI18n } from '@/i18n'
+import type { ModelGroupRow, TokenUsageData } from '@/lib/routing'
+
+export function UsageOverview({ groups, data, loading }: {
+  groups: ModelGroupRow[]
+  data?: TokenUsageData
+  loading: boolean
+}) {
+  const { locale } = useI18n()
+  const ko = locale === 'ko'
+  const active = new Set(groups.flatMap(g => g.members.filter(m => m.enabled && (m.source ?? 'catalog') === 'catalog' && m.platform !== 'custom').map(m => `${m.platform}:${m.modelId}`)))
+  const known = data?.models.filter(m => active.has(`${m.platform}:${m.modelId}`) && m.budget > 0)
+  const remaining = known?.reduce((sum, m) => sum + Math.max(0, m.budget - (m.used ?? 0)), 0)
+  return (
+    <section className="flex min-h-0 flex-1 flex-col items-center justify-center gap-4 p-6 text-center" aria-label={ko ? '남은 무료 총량' : 'Remaining free capacity'}>
+      <h1 className="text-base font-medium text-muted-foreground">{ko ? '남은 무료 토큰 · 추정' : 'Remaining free tokens · Estimated'}</h1>
+      <p className="break-all text-4xl font-semibold tabular-nums">{loading || !data ? (ko ? '조회 중' : 'Loading') : known?.length ? remaining!.toLocaleString(locale) : (ko ? '미확인' : 'Unknown')}</p>
+      <p className="text-xs text-muted-foreground">{ko ? '등록된 활성 모델의 월 카탈로그 한도 기준 · 업체 실제 잔액 미연동' : 'Active models’ monthly catalog limits · Actual balances not connected'}</p>
+    </section>
+  )
+}
