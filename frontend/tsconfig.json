{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@platform/*": [
        "src/*"
      ],
      "@hermes-official/*": [
        "../backend/ai_agent/choki/engine/upstream/web/src/*"
      ],
      "@/*": [
        "../backend/ai_agent/choki/engine/upstream/web/src/*"
      ],
      "@hermes/shared": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/index.ts"
      ],
      "@hermes/shared/*": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/src/*"
      ],
      "@hermes/shared/ansi": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/ansi.ts"
      ],
      "@hermes/shared/billing": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/billing-types.ts"
      ],
      "@hermes/shared/billing-policy": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/billing-policy.ts"
      ],
      "@hermes/shared/charge-settlement": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/charge-settlement.ts"
      ],
      "@hermes/shared/color": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/color.ts"
      ],
      "@hermes/shared/format": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/format.ts"
      ],
      "@hermes/shared/fuzzy": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/fuzzy.ts"
      ],
      "@hermes/shared/gateway-events": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/gateway-events.ts"
      ],
      "@hermes/shared/i18n": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/i18n.ts"
      ],
      "@hermes/shared/json-rpc-channel": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/json-rpc-channel.ts"
      ],
      "@hermes/shared/model-search-text": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/model-search-text.ts"
      ],
      "@hermes/shared/plan-usage": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/plan-usage.ts"
      ],
      "@hermes/shared/reasoning-effort": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/reasoning-effort.ts"
      ],
      "@hermes/shared/reconnect-backoff": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/reconnect-backoff.ts"
      ],
      "@hermes/shared/skin": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/skin.ts"
      ],
      "@hermes/shared/slash": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/slash.ts"
      ],
      "@hermes/shared/theme-presets": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/theme-presets.ts"
      ],
      "@hermes/shared/usage-tick": [
        "../backend/ai_agent/choki/engine/upstream/apps/shared/./src/usage-tick.ts"
      ]
    }
  },
  "include": [
    "src",
    "../modules/**/frontend/**/*.ts",
    "../modules/**/frontend/**/*.tsx",
    "../backend/ai_agent/choki/engine/upstream/web/src/plugins/sdk.d.ts"
  ]
}
